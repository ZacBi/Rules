# Generated from the unified strategy model
name: Rules 策略分流
desc: Stash iOS 轻量分组、规则集、常见 HTTP 改写与脚本入口。
homepage: https://github.com/ZacBi/Rules
author: Rules contributors
category: Policy
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false

proxy-groups: #!replace
  - name: "全部节点"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png"
    include-all: true
    filter: "(?i)^(?!.*(剩余|流量|到期|过期|套餐|官网|订阅|更新|重置|用户|倍率|余额|Traffic|Expire|Expiry|Subscription|Reset)).*$"
  - name: "自动选择"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Speedtest.png"
    include-all: true
    filter: "(?i)^(?!.*(剩余|流量|到期|过期|套餐|官网|订阅|更新|重置|用户|倍率|余额|Traffic|Expire|Expiry|Subscription|Reset)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 100
    lazy: true
  - name: "节点选择"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png"
    proxies:
      - "自动选择"
      - "全部节点"
      - "香港节点"
      - "台湾节点"
      - "日本节点"
      - "新加坡节点"
      - "美国节点"
      - "英国节点"
      - "澳洲节点"
      - "马来西亚节点"
      - "阿根廷节点"
      - "DIRECT"
  - name: "国外媒体"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ForeignMedia.png"
    proxies:
      - "节点选择"
      - "自动选择"
      - "全部节点"
      - "香港节点"
      - "台湾节点"
      - "日本节点"
      - "新加坡节点"
      - "美国节点"
  - name: "AI平台"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AI.png"
    proxies:
      - "节点选择"
      - "自动选择"
      - "全部节点"
      - "香港节点"
      - "日本节点"
      - "新加坡节点"
      - "美国节点"
  - name: "Claude"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AI.png"
    proxies:
      - "节点选择"
      - "自动选择"
      - "全部节点"
      - "香港节点"
      - "台湾节点"
      - "日本节点"
      - "新加坡节点"
      - "美国节点"
      - "英国节点"
      - "澳洲节点"
      - "马来西亚节点"
      - "阿根廷节点"
  - name: "即时通讯"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png"
    proxies:
      - "节点选择"
      - "自动选择"
      - "全部节点"
      - "香港节点"
      - "台湾节点"
      - "日本节点"
      - "新加坡节点"
      - "美国节点"
  - name: "微软服务"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Microsoft.png"
    proxies:
      - "DIRECT"
      - "节点选择"
      - "自动选择"
      - "全部节点"
      - "香港节点"
      - "日本节点"
      - "新加坡节点"
      - "美国节点"
  - name: "苹果服务"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple_2.png"
    proxies:
      - "DIRECT"
      - "节点选择"
      - "自动选择"
      - "全部节点"
  - name: "游戏平台"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Game.png"
    proxies:
      - "节点选择"
      - "自动选择"
      - "全部节点"
