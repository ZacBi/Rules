rules:
  - "DOMAIN,localhost,DIRECT"
  - "DOMAIN-SUFFIX,local,DIRECT"
  - "IP-CIDR,127.0.0.0/8,DIRECT,no-resolve"
  - "IP-CIDR6,::1/128,DIRECT,no-resolve"
  - "RULE-SET,advertising,广告拦截"
  - "RULE-SET,openai,AI平台"
  - "RULE-SET,claude,AI平台"
  - "RULE-SET,anthropic,AI平台"
  - "RULE-SET,gemini,AI平台"
  - "RULE-SET,copilot,AI平台"
  - "RULE-SET,youtube,国外媒体"
  - "RULE-SET,netflix,国外媒体"
  - "RULE-SET,spotify,国外媒体"
  - "RULE-SET,tiktok,国外媒体"
  - "RULE-SET,globalmedia,国外媒体"
  - "RULE-SET,github,AI平台"
  - "RULE-SET,npmjs,开发工具"
  - "RULE-SET,docker,开发工具"
  - "RULE-SET,python,开发工具"
  - "RULE-SET,gitlab,开发工具"
  - "RULE-SET,scholar,学习研究"
  - "RULE-SET,wikipedia,学习研究"
  - "RULE-SET,stackexchange,学习研究"
  - "RULE-SET,google,国外网站"
  - "RULE-SET,telegram,即时通讯"
  - "RULE-SET,discord,即时通讯"
  - "RULE-SET,twitter,国外网站"
  - "RULE-SET,microsoft,微软服务"
  - "RULE-SET,apple,苹果服务"
  - "RULE-SET,steam,游戏平台"
  - "RULE-SET,epic,游戏平台"
  - "RULE-SET,lan,国内网站"
  - "RULE-SET,chinamedia,国内网站"
  - "RULE-SET,china,国内网站"
  - "MATCH,漏网之鱼"

url-rewrite:
  # reject-tracking
  - "^https?:\\/\\/([^/]+)\\/.*[?&](utm_(source|medium|campaign)|spm)=.*$ 302 https://$1/"
script:
  assistant-panel:
    type: generic
    url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/openai/openai-panel.js"
    interval: 86400
  runtime-support:
    type: generic
    script: |
      const runtimeSupport = {
        "stash": {
          "rewrite": "full",
          "script": "full",
          "mitm": "full"
        },
        "surge": {
          "rewrite": "full",
          "script": "full",
          "mitm": "full"
        },
        "mihomo": {
          "rewrite": "partial",
          "script": "unsupported",
          "mitm": "unsupported"
        }
      };
      module.exports = runtimeSupport;
mitm:
  enabled: true
  hostnames:
    - "*.openai.com"
    - "*.anthropic.com"
    - "*.githubusercontent.com"
