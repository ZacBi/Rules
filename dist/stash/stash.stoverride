# Generated from the unified strategy model
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: true

proxy-groups:
  - name: "智能优选"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Speedtest.png"
    include-all: true
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "手动选择"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png"
    proxies:
      - "智能优选"
      - "香港"
      - "台湾"
      - "日本"
      - "新加坡"
      - "美国"
      - "英国"
      - "澳洲"
      - "马来西亚"
      - "阿根廷"
      - DIRECT
  - name: "香港"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png"
    include-all: true
    filter: "(?i)(香港|HK|Hong\\s*Kong)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "台湾"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png"
    include-all: true
    filter: "(?i)(台湾|TW|Taiwan|Taipei)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "日本"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png"
    include-all: true
    filter: "(?i)(日本|JP|Japan|Tokyo|Osaka)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "新加坡"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png"
    include-all: true
    filter: "(?i)(新加坡|狮城|SG|Singapore)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "美国"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States_Map.png"
    include-all: true
    filter: "(?i)(美国|US|USA|United\\s*States|America|Los\\s*Angeles|San\\s*Jose|Seattle)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "英国"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_Kingdom.png"
    include-all: true
    filter: "(?i)(英国|UK|United\\s*Kingdom|Britain|England|London|Manchester)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "澳洲"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Australia.png"
    include-all: true
    filter: "(?i)(澳洲|澳大利亚|AU|Australia|Sydney|Melbourne|Perth)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "马来西亚"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Malaysia.png"
    include-all: true
    filter: "(?i)(马来西亚|MY|Malaysia|Kuala\\s*Lumpur)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "阿根廷"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Argentina.png"
    include-all: true
    filter: "(?i)(阿根廷|AR|Argentina|Buenos\\s*Aires)"
    url: "https://www.gstatic.com/generate_204"
    interval: 300
    lazy: true
  - name: "国外媒体"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/ForeignMedia.png"
    proxies:
      - "手动选择"
      - "智能优选"
      - "香港"
      - "台湾"
      - "日本"
      - "新加坡"
      - "美国"
      - "英国"
      - "澳洲"
      - "马来西亚"
      - "阿根廷"
  - name: "AI平台"
