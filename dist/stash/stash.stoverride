# Generated from the unified strategy model
name: Rules 策略分流
desc: Stash iOS 轻量分组、规则集、常见 HTTP 改写与脚本入口。
homepage: https://github.com/ZacBi/Rules
author: Rules contributors
category: Policy
mixed-port: 7890
allow-lan: false
mode: rule
log-level: info
ipv6: false

proxy-groups: #!replace
  - name: "Rules 手动节点"
    type: select
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png"
    include-all: true
    filter: "(?i)^(?!.*(剩余|流量|到期|过期|套餐|官网|订阅|更新|重置|用户|倍率|余额|Traffic|Expire|Expiry|Subscription|Reset)).*$"
    proxies:
      - "Rules 自动优选"
      - "Rules 香港"
      - "Rules 台湾"
      - "Rules 日本"
      - "Rules 新加坡"
      - "Rules 美国"
      - "Rules 英国"
      - "Rules 澳洲"
      - "Rules 马来西亚"
      - "Rules 阿根廷"
      - DIRECT
  - name: "Rules 自动优选"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Speedtest.png"
    include-all: true
    filter: "(?i)^(?!.*(剩余|流量|到期|过期|套餐|官网|订阅|更新|重置|用户|倍率|余额|Traffic|Expire|Expiry|Subscription|Reset)).*$"
    url: "https://www.gstatic.com/generate_204"
    interval: 600
    tolerance: 100
    lazy: true
  - name: "Rules AI 检测"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AI.png"
    proxies:
      - "Rules 香港"
      - "Rules 日本"
      - "Rules 新加坡"
      - "Rules 美国"
    url: "https://auth.openai.com/.well-known/openid-configuration"
    interval: 600
    tolerance: 100
    lazy: true
  - name: "Rules Gemini 检测"
    type: url-test
    icon: "https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Google_Search.png"
