# Generated from the unified strategy model
# The module is designed to be included on top of a profile that already resolves subscription parsing upstream.
# No policy-path placeholder is used here.

[General]
loglevel = notify
ipv6 = true
enhanced-mode-by-rule = true

[Proxy Group]
自动选择 = url-test, policy-regex-filter='^((?!(自动选择|节点选择|DIRECT|REJECT)).)*$', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
节点选择 = select, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点, DIRECT
香港节点 = url-test, policy-regex-filter='香港|HK|Hong\s*Kong', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
台湾节点 = url-test, policy-regex-filter='台湾|TW|Taiwan|Taipei', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
日本节点 = url-test, policy-regex-filter='日本|JP|Japan|Tokyo|Osaka', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
新加坡节点 = url-test, policy-regex-filter='新加坡|狮城|SG|Singapore', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
美国节点 = url-test, policy-regex-filter='美国|US|USA|United\s*States|America|Los\s*Angeles|San\s*Jose|Seattle', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
英国节点 = url-test, policy-regex-filter='英国|UK|United\s*Kingdom|Britain|England|London|Manchester', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
澳洲节点 = url-test, policy-regex-filter='澳洲|澳大利亚|AU|Australia|Sydney|Melbourne|Perth', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
马来西亚节点 = url-test, policy-regex-filter='马来西亚|MY|Malaysia|Kuala\s*Lumpur', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
阿根廷节点 = url-test, policy-regex-filter='阿根廷|AR|Argentina|Buenos\s*Aires', url=https://www.gstatic.com/generate_204, interval=300, tolerance=50, timeout=5
国外媒体 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点
AI平台 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点
开发工具与镜像 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点, DIRECT
学习与研究 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点, DIRECT
即时通讯 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点
微软服务 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点, DIRECT
苹果服务 = select, DIRECT, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点
游戏平台 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点
国外网站 = select, 节点选择, 自动选择, 香港节点, 台湾节点, 日本节点, 新加坡节点, 美国节点, 英国节点, 澳洲节点, 马来西亚节点, 阿根廷节点
国内网站 = select, DIRECT, 节点选择
广告拦截 = select, REJECT, DIRECT
漏网之鱼 = select, 节点选择, 自动选择, DIRECT

[Rule]
RULE-SET,LAN,DIRECT
DOMAIN,localhost,DIRECT
DOMAIN-SUFFIX,local,DIRECT
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR6,::1/128,DIRECT,no-resolve
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Surge/Advertising/Advertising.list,广告拦截,extended-matching
