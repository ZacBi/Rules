[URL Rewrite]
# reject-tracking
^https?:\/\/([^/]+)\/.*[?&](utm_(source|medium|campaign)|spm)=.*$ 302 https://$1/

[Script]
assistant-panel = type=http-response, pattern=^https://(chatgpt|api\.openai)\.com/.*, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/openai/openai-panel.js, timeout=10

[MITM]
hostname = %APPEND% *.openai.com, *.anthropic.com, *.githubusercontent.com
